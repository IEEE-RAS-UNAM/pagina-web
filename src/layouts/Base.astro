---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITIO, type SeccionActiva } from '../lib/sitio';

interface Props {
  titulo?: string;
  descripcion?: string;
  activo?: SeccionActiva;
}

const { titulo, descripcion = SITIO.descripcion, activo = 'inicio' } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${SITIO.nombreCorto}` : SITIO.nombreCorto;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="text/calendar" title="Calendario de eventos" href="/eventos.ics" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,400;0,600;0,700;0,800;1,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-white focus:p-3" href="#contenido">
      Saltar al contenido
    </a>
    <Header activo={activo} />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>
