---
import Logo from './Logo.astro';
import { SITIO, NAV } from '../lib/sitio';

const anio = new Date().getFullYear();
const c = SITIO.contacto;
const contacto = [
  { label: c.correo ?? '[correo del capítulo]', href: c.correo ? `mailto:${c.correo}` : null },
  { label: c.instagram ? 'Instagram' : '[Instagram]', href: c.instagram },
  { label: c.linkedin ? 'LinkedIn' : '[LinkedIn]', href: c.linkedin },
  { label: c.github ? 'GitHub' : '[GitHub]', href: c.github },
];

// Clases repetidas del pie, para mandarlas a llamar cuando hagan falta.
const titulo = 'text-xs font-bold uppercase tracking-[0.12em] text-rosa';
const enlace = 'text-white no-underline hover:text-white hover:underline';
---

<footer class="bg-carbon text-white">
  <div class="cuna-der h-2.5 w-[62%] bg-rojo [--h:10px]" aria-hidden="true"></div>

  <div class="mx-auto flex max-w-7xl flex-col gap-10 px-6 pb-7 pt-12">
    <div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-8 text-sm">
      <div class="flex flex-col gap-2">
        <span class="text-[17px] font-extrabold leading-tight">{SITIO.universidad}</span>
        <span class="text-[15px] font-semibold text-rosa">{SITIO.capitulo}</span>
        <span class="leading-normal text-rosa-2">
          Facultad de Ingeniería, Ciudad Universitaria, CDMX. IEEE Región 9 · Latinoamérica.
        </span>
      </div>

      <nav aria-label="Sitio" class="flex flex-col gap-2">
        <span class={titulo}>Sitio</span>
        {NAV.map((n) => <a href={n.href} class={enlace}>{n.label}</a>)}
        <a href="/eventos.ics" class={enlace}>Calendario (iCal)</a>
      </nav>

      <nav aria-label="Comunidad IEEE" class="flex flex-col gap-2">
        <span class={titulo}>Comunidad</span>
        <a href="https://www.ieee-ras.org" class={enlace}>IEEE Robotics and Automation Society</a>
        <a href="https://www.ieeelatam.org" class={enlace}>IEEE Región 9</a>
        {
          SITIO.rama.url ? (
            <a href={SITIO.rama.url} class={enlace}>
              {SITIO.rama.nombre}
            </a>
          ) : (
            <span>[{SITIO.rama.nombre}]</span>
          )
        }
        <a href="https://events.vtools.ieee.org" class={enlace}>Eventos en IEEE vTools</a>
      </nav>

      <div class="flex flex-col gap-2">
        <span class={titulo}>Contacto</span>
        {contacto.map((x) => (x.href ? <a href={x.href} class={enlace}>{x.label}</a> : <span>{x.label}</span>))}
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-4 border-t border-[#4a474d] pt-5.5">
      <div class="flex flex-[1_1_420px] flex-col gap-1.5 text-xs leading-normal text-rosa-2">
        <span>© {anio} {SITIO.nombreCorto} Student Branch Chapter.</span>
        <span class="flex flex-wrap gap-x-4 gap-y-1">
          <a href="https://www.ieee.org/accessibility-statement.html" class="text-white hover:text-rosa">Accesibilidad</a>
          <a href="https://www.ieee.org/about/corporate/governance/p9-26.html" class="text-white hover:text-rosa">
            Política de no discriminación
          </a>
          <!--Obligado no discriminar no sean gachos -->
          <a href="https://www.ieee.org/security-privacy.html" class="text-white hover:text-rosa">Privacidad IEEE</a>
        </span>
      </div>
      <Logo
        src={SITIO.logos.ieeeBlanco}
        alt="IEEE"
        etiqueta="Logo IEEE<br>(versión blanca)"
        ancho={120}
        alto={40}
        claro
      />
    </div>
  </div>
</footer>
