---
// Texto pequeño en mayúsculas con una raya antes ("ceja" o eyebrow).
interface Props {
  clara?: boolean; // para fondos rojos u oscuros
  color?: string; // variable CSS opcional, p. ej. 'var(--color-morado)'
}
const { clara = false, color } = Astro.props;
---

<span
  class:list={[
    'flex items-center gap-3 text-[13px] font-bold uppercase tracking-[0.14em]',
    clara ? 'text-rosa' : color ? 'text-(--c)' : 'text-gris',
  ]}
  style={color ? `--c:${color}` : undefined}
>
  <span
    aria-hidden="true"
    class:list={['h-[3px] w-7', clara ? 'bg-white' : color ? 'bg-(--c)' : 'bg-rojo']}
  ></span>
  <slot />
</span>
